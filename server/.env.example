# Same PostgreSQL URL shape as backend/.env (see docker-compose: port 5433, db accessai)
DATABASE_URL="postgresql://postgres:root@localhost:5433/accessai"

# JWT — must match backend/.env for tokens to work across Python ↔ Node during migration
SECRET_KEY="changeme"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# CORS — must include your deployed frontend origin
FRONTEND_URL="https://your-vercel-app.vercel.app"

# Listen (default 8000 to match VITE_API_BASE_URL during cutover)
PORT=8000
HOST=0.0.0.0
