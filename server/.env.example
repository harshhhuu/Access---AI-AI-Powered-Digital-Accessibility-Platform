# Same PostgreSQL URL shape as backend/.env (see docker-compose: port 5433, db accessai)
DATABASE_URL="postgresql://postgres:root@localhost:5433/accessai"

# JWT — must match backend/.env for tokens to work across Python ↔ Node during migration
SECRET_KEY="changeme"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Hugging Face (required for POST /api/simplify)
HF_API_TOKEN=
HF_TEXT_MODEL="Qwen/Qwen2.5-72B-Instruct:novita"

# CORS — include Vite dev origin(s), e.g. http://localhost:5173
FRONTEND_URL="https://your-vercel-app.vercel.app"

# Listen (use 8001 if Python uses 8000)
PORT=8000
HOST=0.0.0.0
